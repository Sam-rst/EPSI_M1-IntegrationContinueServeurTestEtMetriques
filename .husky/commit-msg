# commit-msg : impose le format Conventional Commits sur la 1re ligne.
#   <type>(scope optionnel)!: description
msg_file="$1"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .+'

if ! head -n 1 "$msg_file" | grep -qE "$pattern"; then
  echo "❌ Message de commit non conforme aux Conventional Commits."
  echo "   Format : <type>(scope): description"
  echo "   Types  : feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "   Ex.    : feat(api): ajoute la route /convert"
  exit 1
fi
