{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:fix": "tsc --noEmit",
    "deadcode": "knip",
    "tests:unit": "vitest run unit",
    "tests:integ": "vitest run integ",
    "tests:e2e": "playwright test",
    "tests:coverage": "vitest run --coverage",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "audit:code": "oxlint -D correctness -D suspicious -D perf",
    "quality": "npm run lint && npm run format && npm run typecheck && npm run deadcode",
    "tests": "npm run tests:unit && npm run tests:integ",
    "security": "npm run audit:deps && npm run audit:code",
    "ci": "npm run quality && npm run tests && npm run security"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.6",
    "jsdom": "^25.0.1",
    "knip": "^6.25.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.6"
  }
}
